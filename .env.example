# Database
DATABASE_URL="postgresql://shoestore:shoestore@localhost:5432/shoestore?schema=public"

# JWT
JWT_SECRET="change-me-super-secret-key"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# App
PORT=4000
NODE_ENV=development
API_PREFIX=api
CORS_ORIGINS="http://localhost:3000,http://localhost:8080"
PUBLIC_UPLOAD_URL="http://localhost:4000/uploads"

# Demo seed admin
SEED_ADMIN_EMAIL="admin@shoestore.com"
SEED_ADMIN_PASSWORD="Admin@123"
